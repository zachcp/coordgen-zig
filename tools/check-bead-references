#!/usr/bin/env python3
"""Validate PR/commit Bead trailers against the live Beads database."""

import argparse
import datetime
import json
import re
import subprocess
import sys
from pathlib import Path


TRAILER = re.compile(r"^\s*Beads?\s*:\s*(.*?)\s*$", re.IGNORECASE)
BEAD_ID = re.compile(r"(?<![0-9a-z.-])cgz-[0-9a-z]+(?:\.[0-9]+)*(?![0-9a-z.-])")


def parse_time(value):
    if value is None:
        return None
    return datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))


def evidence_ids(texts):
    found = set()
    malformed = []
    for source, text in texts:
        for line_number, line in enumerate(text.splitlines(), 1):
            match = TRAILER.match(line)
            if match is None:
                continue
            ids = BEAD_ID.findall(match.group(1))
            if not ids:
                malformed.append(f"{source}:{line_number}: Bead trailer has no cgz- ID")
            found.update(ids)
    return sorted(found), malformed


def branch_closures(diff):
    closed = set()
    for line in diff.splitlines():
        if not line.startswith("+") or line.startswith("+++"):
            continue
        try:
            interaction = json.loads(line[1:])
        except json.JSONDecodeError:
            continue
        extra = interaction.get("extra", {})
        if (
            interaction.get("kind") == "field_change"
            and extra.get("field") == "status"
            and extra.get("new_value") == "closed"
        ):
            closed.add(interaction.get("issue_id"))
    return closed


def query_issue(bead_id):
    result = subprocess.run(
        ["bd", "--readonly", "show", f"--id={bead_id}", "--json"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        return None
    rows = json.loads(result.stdout)
    return rows[0] if len(rows) == 1 and rows[0].get("id") == bead_id else None


def validate(texts, pr_created_at, fixture_issues=None, closed_on_branch=()):
    ids, errors = evidence_ids(texts)
    if not ids and not errors:
        errors.append("no 'Bead: cgz-...' evidence in the PR body or commit messages")

    fixtures = None
    if fixture_issues is not None:
        fixtures = {issue["id"]: issue for issue in fixture_issues}

    for bead_id in ids:
        issue = fixtures.get(bead_id) if fixtures is not None else query_issue(bead_id)
        if issue is None:
            errors.append(f"{bead_id}: unknown bead")
            continue

        status = issue.get("status")
        if status == "in_progress":
            continue
        if status == "open":
            errors.append(f"{bead_id}: bead is open and has not been claimed")
            continue
        if status == "closed":
            closed_at = parse_time(issue.get("closed_at"))
            if bead_id in closed_on_branch or (closed_at is not None and closed_at >= pr_created_at):
                continue
            errors.append(f"{bead_id}: stale reference to a bead closed before this PR")
            continue
        errors.append(f"{bead_id}: unsupported bead status {status!r}")

    return ids, errors


def self_test():
    opened = parse_time("2026-09-18T12:00:00Z")
    issues = [
        {"id": "cgz-live", "status": "in_progress", "closed_at": None},
        {"id": "cgz-done", "status": "closed", "closed_at": "2026-09-18T13:00:00Z"},
        {"id": "cgz-branch", "status": "closed", "closed_at": "2026-09-17T13:00:00Z"},
        {"id": "cgz-open", "status": "open", "closed_at": None},
        {"id": "cgz-stale", "status": "closed", "closed_at": "2026-09-17T13:00:00Z"},
    ]
    cases = [
        ("claimed", [("body", "Bead: cgz-live")], True, None),
        ("closed during PR", [("commit", "Beads: cgz-done, cgz-live")], True, None),
        ("closed on branch", [("body", "Bead: cgz-branch")], True, None),
        ("missing", [("body", "No tracker evidence")], False, "no 'Bead:"),
        ("malformed", [("body", "Bead: cgz-replace-me")], False, "has no cgz- ID"),
        ("unknown", [("body", "Bead: cgz-unknown")], False, "unknown bead"),
        ("unclaimed", [("body", "Bead: cgz-open")], False, "has not been claimed"),
        ("stale", [("body", "Bead: cgz-stale")], False, "closed before this PR"),
    ]
    for name, texts, should_pass, expected in cases:
        branch = {"cgz-branch"} if name == "closed on branch" else set()
        _ids, errors = validate(texts, opened, issues, branch)
        if (not errors) != should_pass or (expected and not any(expected in error for error in errors)):
            print(f"check-bead-references: self-test {name!r} failed: {errors}", file=sys.stderr)
            return 1
    print("check-bead-references: self-test passed 8 positive and negative fixtures")
    return 0


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--pr-body", type=Path)
    parser.add_argument("--commits", type=Path)
    parser.add_argument("--interactions-diff", type=Path)
    parser.add_argument("--pr-created-at")
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args()

    if args.self_test:
        return self_test()
    if args.pr_body is None or args.commits is None or args.interactions_diff is None or args.pr_created_at is None:
        parser.error("--pr-body, --commits, --interactions-diff, and --pr-created-at are required")

    texts = [
        (str(args.pr_body), args.pr_body.read_text(encoding="utf-8")),
        (str(args.commits), args.commits.read_text(encoding="utf-8")),
    ]
    ids, errors = validate(
        texts,
        parse_time(args.pr_created_at),
        closed_on_branch=branch_closures(args.interactions_diff.read_text(encoding="utf-8")),
    )
    if errors:
        print("check-bead-references: tracker evidence is invalid:", file=sys.stderr)
        for error in errors:
            print(f"  {error}", file=sys.stderr)
        return 1
    print(f"check-bead-references: verified {', '.join(ids)} against the live tracker")
    return 0


if __name__ == "__main__":
    sys.exit(main())
