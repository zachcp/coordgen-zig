#!/usr/bin/env python3
"""Assert that the build's C/C++ gates are strict everywhere, not somewhere.

The previous version of this check grepped build.zig for one strict C flag
literal and one strict C++ flag literal and printed "verified strict ABI
flags". That proves a strict flag set appears *at least once*. It says
nothing about the other thirteen compile sites, so a new addCSourceFile with
-Werror quietly dropped would have left the gate green while its summary line
claimed the opposite - the cgz-r28 shape, in the gate whose entire job is
catching that shape.

This version enumerates every addCSourceFile/addCSourceFiles call in
build.zig, pairs each with the sources it compiles, and requires:

  * Repo-owned sources (b.path(...)) use one of APPROVED_STRICT verbatim.
  * Upstream-owned sources (the pinned oracle package, and the two
    translation units the instrumentation patches regenerate from it) use one
    of UPSTREAM_EXEMPT. Upstream C++ does not compile clean under -Werror and
    is not this repo's to fix; the exemption is narrow, enumerated, and
    applies to provenance rather than to a directory name.

Anything else is a violation, including a *stricter* unlisted set: the point
is that the flag policy is a closed table someone has to edit deliberately.

Run with --self-test to prove the check rejects a planted weakening.
"""

import re
import sys
import os

APPROVED_STRICT = {
    ('-std=c11', '-Wall', '-Wextra', '-Werror', '-pedantic'),
    ('-std=c++17', '-Wall', '-Wextra', '-Werror'),
    # Compiled into the oracle library beside upstream's sources; -DIN_COORDGEN
    # buys visibility of upstream internals, not an exemption from -Werror.
    ('-std=c++17', '-DIN_COORDGEN', '-Wall', '-Wextra', '-Werror'),
}

UPSTREAM_EXEMPT = {
    ('-std=c++17', '-DIN_COORDGEN'),
    ('-std=c++17',),
}

# How a source block names something this repo did not write. `oracle.path`
# reaches into the pinned dependency; the instrumented_* lazy paths are
# upstream translation units regenerated by conformance/patches.
_UPSTREAM_MARKERS = ('oracle.path(', 'instrumented_fragment_builder', 'instrumented_minimizer')

_CALL_RE = re.compile(r'add(CSourceFile|CSourceFiles)\(\.\{')
_FLAGS_RE = re.compile(r'\.flags = &\.\{([^}]*)\}')
_STRING_RE = re.compile(r'"([^"]*)"')

_REQUIRED_TEXT = [
    # The remaining placeholder gate must fail loudly rather than pass
    # vacuously until its owning bead attaches real artifacts. Examples and
    # template regeneration are real gates covered by the graph assertion.
    'const fuzz_pending = b.addFail("fuzz is not implemented yet; see cgz-7v2.4.4")',
    # The real, graph-level false-green assertion. Whether each step actually
    # has dependencies is checked by build.zig itself at configure time, where
    # the constructed graph can be inspected; grepping for "<step>.dependOn("
    # only ever proved that a source line existed. What is verified here is
    # that the assertion is still wired up at all.
    'assertNoFalseGreenSteps(&.{',
]


def _brace_match(text, open_index):
    """Index just past the `}` closing the `{` at open_index."""
    depth = 0
    for i in range(open_index, len(text)):
        if text[i] == '{':
            depth += 1
        elif text[i] == '}':
            depth -= 1
            if depth == 0:
                return i + 1
    raise ValueError('unbalanced braces in build.zig')


def source_blocks(text):
    """Yield (line_number, block_text) for every C/C++ source call."""
    for match in _CALL_RE.finditer(text):
        open_index = text.index('{', match.end() - 2)
        end = _brace_match(text, open_index)
        yield text.count('\n', 0, match.start()) + 1, text[match.start():end]


def scan(build_file):
    with open(build_file, 'r', encoding='utf-8') as fh:
        text = fh.read()

    violations = []
    blocks = list(source_blocks(text))
    if not blocks:
        violations.append('build.zig declares no C/C++ sources; this check has nothing to constrain')

    for line, block in blocks:
        flags_match = _FLAGS_RE.search(block)
        if flags_match is None:
            violations.append(f'build.zig:{line}: C/C++ sources compiled with no .flags at all')
            continue
        flags = tuple(_STRING_RE.findall(flags_match.group(1)))
        upstream = any(marker in block for marker in _UPSTREAM_MARKERS)
        allowed = UPSTREAM_EXEMPT if upstream else APPROVED_STRICT
        if flags not in allowed:
            owner = 'upstream-owned' if upstream else 'repo-owned'
            violations.append(
                f'build.zig:{line}: {owner} sources use unapproved flags {list(flags)}; '
                f'allowed for {owner} sources: '
                + ' or '.join(str(list(f)) for f in sorted(allowed))
            )

    if '-Wno-' in text:
        violations.append('build.zig: ABI/build gates may not suppress warnings without a recorded decision')

    for required in _REQUIRED_TEXT:
        if required not in text:
            violations.append(f'build.zig: missing required build policy: {required}')

    return violations, len(blocks)


def run_self_test(repo_root):
    """Plant a weakening the old grep-based check would have missed."""
    import tempfile
    import shutil

    with open(os.path.join(repo_root, 'build.zig'), 'r', encoding='utf-8') as fh:
        text = fh.read()

    tmp = tempfile.mkdtemp(prefix='cgz-gate-strength-')
    try:
        planted = os.path.join(tmp, 'build.zig')

        # Fixture 1: a repo-owned source drops -Werror. Every *other* compile
        # site keeps its strict flags, which is exactly the case a
        # "does the strict literal appear anywhere" grep cannot see.
        weakened = text.replace(
            '.file = b.path("tests/rdkit_consumer.cpp"),\n'
            '            .flags = &.{ "-std=c++17", "-Wall", "-Wextra", "-Werror" },',
            '.file = b.path("tests/rdkit_consumer.cpp"),\n'
            '            .flags = &.{ "-std=c++17", "-Wall" },',
            1,
        )
        if weakened == text:
            print('check-gate-strength: self-test fixture no longer matches build.zig', file=sys.stderr)
            return False
        shutil.copy(os.path.join(repo_root, 'build.zig'), planted)
        with open(planted, 'w', encoding='utf-8') as fh:
            fh.write(weakened)
        weakened_hit = any('unapproved flags' in v for v in scan(planted)[0])

        # Fixture 2: the graph-level false-green assertion is removed.
        with open(planted, 'w', encoding='utf-8') as fh:
            fh.write(text.replace('assertNoFalseGreenSteps(&.{', 'noop(&.{', 1))
        assertion_hit = any('assertNoFalseGreenSteps' in v for v in scan(planted)[0])

        # Control: the real file is clean, so the check is not just failing
        # everything it is handed.
        control, _ = scan(os.path.join(repo_root, 'build.zig'))

        if not (weakened_hit and assertion_hit and not control):
            print('check-gate-strength: self-test FAILED', file=sys.stderr)
            if not weakened_hit:
                print('  a repo-owned source that dropped -Werror was not caught', file=sys.stderr)
            if not assertion_hit:
                print('  a removed false-green assertion was not caught', file=sys.stderr)
            for v in control:
                print(f'  flagged the real build.zig: {v}', file=sys.stderr)
            return False

        print(
            'check-gate-strength: self-test verified that a single repo-owned source '
            'dropping -Werror and a removed false-green assertion are both caught, '
            'and that the real build.zig is left alone'
        )
        return True
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def main(argv):
    repo_root = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), '..'))

    if argv[1:2] == ['--self-test']:
        return 0 if run_self_test(repo_root) else 1

    violations, block_count = scan(os.path.join(repo_root, 'build.zig'))
    if violations:
        print('check-gate-strength: found weakened build gates:', file=sys.stderr)
        for v in violations:
            print(f'  {v}', file=sys.stderr)
        return 1
    print(
        f'check-gate-strength: verified strict flags on all {block_count} C/C++ compile '
        'sites, no warning suppressions, and that the reserved steps still fail loudly'
    )
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
