#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# This repository has no long-lived services. Fail quickly if a restored orb
# lost either tool installed by setup; the next setup run can repair it.
command -v zig >/dev/null
command -v bd >/dev/null
test "$(zig version)" = "$(awk -F '\t' '$1 == "version" { print $2; exit }' toolchain.lock)"

echo "resume: pinned Zig and bd are available; no services to restart"
